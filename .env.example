# o2cloud environment variables — copy to `.env` and fill in as needed.
#
# SECRETS: never commit a real `.env`. These override the OS keyring for headless /
# agent use. If unset, o2cloud reads secrets from the keyring (service o2cloud:<profile>).
#
# --- Secrets (keyring fallback) ---------------------------------------------
# O2CLOUD_USERNAME=your-dni-or-username
# O2CLOUD_PASSWORD=your-password
# O2CLOUD_TOKEN=captured-sapi-session-token
# O2CLOUD_COOKIE=captured-sapi-session-cookie
#
# --- Non-secret config overrides (every AppConfig field via O2CLOUD_<KEY>) ---
# O2CLOUD_BASE_URL=https://cloud.o2online.es
# O2CLOUD_USER_AGENT=o2cloud/0.4.0
# O2CLOUD_DEVICE_ID=
# O2CLOUD_REQUEST_RATE_PER_SEC=4.0
# O2CLOUD_DEFAULT_REMOTE_ROOT=/
# O2CLOUD_DEFAULT_DOWNLOAD_DIR=
#
# --- OIDC (non-secret; observed defaults, override only if the IdP changes) --
# O2CLOUD_OIDC_AUTHORIZE_BASE=https://t3.o2online.es/acceso/
# O2CLOUD_OIDC_CLIENT_NAME=O2CLOUD_WEB
# O2CLOUD_OIDC_CLIENT_ID=7f8afae4-30e7-4591-b4a8-4fc08d545d1d
# O2CLOUD_OIDC_SCOPE=openid
# O2CLOUD_OIDC_ACR_VALUES=2
# O2CLOUD_OIDC_REDIRECT_URI=https://cloud.o2online.es/sapi/login/oauth
#
# --- Local path overrides (non-secret) --------------------------------------
# O2CLOUD_CONFIG_DIR=/custom/config/dir
# O2CLOUD_STATE_DIR=/custom/state/dir
#
# --- Opt-in live smoke test -------------------------------------------------
# O2CLOUD_LIVE=1
